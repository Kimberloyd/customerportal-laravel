APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8090

ACCOUNT_DELETION_RETENTION_DAYS=30
DATA_ERASURE_DEADLINE_DAYS=30

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Local Docker credentials only. Generate unique values for every deployed environment.
REVERB_APP_ID=customerportal-local
REVERB_APP_KEY=customerportal-local-key
REVERB_APP_SECRET=customerportal-local-secret
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_ALLOWED_ORIGINS=http://localhost:8090,http://127.0.0.1:8090

# Local Reverb is published directly; production uses nginx and its current origin.
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http

INVENTORY_API_BASE_URL=https://inventoryapp.theomeds.com/theomeds/inventoryapp/v1
INVENTORY_API_TOKEN=

# Meta Messenger Platform. PAGE_ACCESS_TOKEN alone is enough for outbound
# replies (App\Support\FacebookMessenger::sendReply); APP_SECRET and
# WEBHOOK_VERIFY_TOKEN are only needed to receive inbound messages via
# App\Http\Controllers\FacebookWebhookController, which requires a public
# HTTPS URL Meta can reach (not applicable to a plain local dev machine).
META_MESSENGER_PAGE_ACCESS_TOKEN=
META_MESSENGER_APP_SECRET=
META_MESSENGER_WEBHOOK_VERIFY_TOKEN=
META_MESSENGER_GRAPH_API_VERSION=v19.0

# Semaphore (semaphore.co) SMS. Used by App\Support\OrderNotifications to
# text the customer's login phone number a copy of the order summary --
# stays dormant (PO_NOTIFICATIONS_SMS_ENABLED=false) until a real API key
# is set.
SEMAPHORE_API_KEY=
SEMAPHORE_SENDER_NAME=
PO_NOTIFICATIONS_SMS_ENABLED=false
