# Production .env template for the NAS deployment. Copy to `.env` on
# the NAS (`cp .env.production.example .env`) and fill in the blanks --
# see DEPLOY.md for the full step-by-step. This file intentionally has
# no real secrets in it.

APP_NAME="Customer Portal"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# The NAS-local address this will actually be reached at -- e.g.
# http://<nas-ip>:8090. Only used for generating absolute URLs
# (none of this app's own code currently needs it, but Laravel
# expects it set).
APP_URL=http://localhost:8090

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

BCRYPT_ROUNDS=12

# Logs to stderr (captured by `docker compose logs`) instead of a file,
# so storage/logs never needs to be writable -- see docker-compose.yml's
# read_only container setup.
LOG_CHANNEL=stderr
LOG_LEVEL=info

# Same MySQL database the Flask app already uses -- no new database,
# no data migration. DB_PASSWORD is the SAME value already sitting in
# the Flask app's own .env (/volume1/docker/customerportal/.env) --
# copy it from there, never invent a new one here.
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=customer_portal
DB_USERNAME=customer_portal
DB_PASSWORD=

# Deliberately file-based, not database-based -- see DEPLOY.md and the
# plan this was built from for why: the shared business tables already
# exist in the live database via Flask's own migrations, and Laravel's
# migration for its own session/cache/queue tables is bundled together
# with the (already-existing, must-never-be-recreated) users table in
# a way that can't be safely split apart for this deployment.
SESSION_DRIVER=file
SESSION_LIFETIME=120
# false because this private test deployment is served over plain
# HTTP (Tailscale IP, no TLS) -- a Secure-flagged cookie is silently
# refused by the browser over HTTP, so the session (and therefore
# CSRF token) never persists, and every request looks like a fresh
# visitor: this is what caused the 419 "Page Expired" error on first
# login attempt. Flip to true once this is ever served over HTTPS
# (e.g. the eventual customerportal.theomeds.com cutover, which goes
# through Cloudflare's TLS termination).
SESSION_SECURE_COOKIE=false
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# Never run `php artisan migrate` against this database -- see
# DEPLOY.md's warning. This app reads/writes the existing schema
# directly; it does not own or manage it.

# Left disabled -- no live SMTP/Meta Messenger credentials configured
# for this deployment. See App\Support\OrderNotifications and
# App\Support\FacebookMessenger.
PO_NOTIFICATIONS_EMAIL_ENABLED=false
PO_NOTIFICATIONS_FACEBOOK_ENABLED=false
PUBLIC_CONVERSATION_LINK_TTL_HOURS=720

# The Flask stack's Compose network name -- confirm via
# `docker network ls` on the NAS before first boot (see DEPLOY.md);
# override here if it's not actually customerportal_default.
FLASK_NETWORK_NAME=customerportal_default

# Which NAS-local port reaches this app (private only -- no public
# domain/Cloudflare tunnel for this deployment).
HOST_PORT=8090
