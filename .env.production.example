# Production .env template for the NAS deployment. Copy to `.env` on
# the NAS (`cp .env.production.example .env`) and fill in the blanks --
# see DEPLOY.md for the full step-by-step. This file intentionally has
# no real secrets in it.

APP_NAME="Customer Portal"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# Set to the actual public URL this is reached at. During private
# testing (before the Cloudflare cutover) that's the NAS-local
# address, e.g. http://<tailscale-ip>:8090. After cutover, it's
# https://customerportal.theomeds.com.
APP_URL=https://customerportal.theomeds.com
TRUSTED_HOSTS=customerportal.theomeds.com
# Keep the wildcard only while PHP-FPM is reachable exclusively through the
# private Compose proxy network. If app:9000 is ever published, replace this
# with the exact proxy CIDR before deployment.
TRUSTED_PROXIES=*
CSP_REPORT_ONLY=true
SECURITY_HSTS=true
RELIABILITY_HEARTBEAT_MAX_AGE_SECONDS=180
RELIABILITY_CHECK_REDIS=true
ORDER_REMINDERS_ENABLED=false
ORDER_REMINDERS_TIMEZONE=Asia/Manila
ORDER_REMINDERS_QUIET_HOURS_START=20
ORDER_REMINDERS_QUIET_HOURS_END=8
ORDER_REMINDERS_CUSTOMER_SMS_ENABLED=false
ORDER_REMINDERS_ROLLOUT_GRACE_HOURS=24

ACCOUNT_DELETION_RETENTION_DAYS=30
DATA_ERASURE_DEADLINE_DAYS=30

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

BCRYPT_ROUNDS=12

# Logs to stderr (captured by `docker compose logs`) instead of a file,
# so storage/logs never needs to be writable -- see docker-compose.yml's
# read_only container setup.
LOG_CHANNEL=stderr
LOG_LEVEL=info

# Queries slower than this are logged as a warning (see
# AppServiceProvider::configureSlowQueryLogging()).
SLOW_QUERY_THRESHOLD_MS=200

# Same MySQL database the Flask app already uses -- no new database,
# no data migration. DB_PASSWORD is the SAME value already sitting in
# the Flask app's own .env (/volume1/docker/customerportal/.env) --
# copy it from there, never invent a new one here.
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=customer_portal
DB_USERNAME=customer_portal
DB_PASSWORD=

# Store authentication sessions in the existing Redis service. This avoids
# the tmpfs-backed file store, does not require Laravel to own the shared
# Flask database's sessions table, and lets logout revoke a session server-side.
# Database 2 is reserved for sessions, separate from queues (0) and cache (1).
SESSION_DRIVER=redis
SESSION_CONNECTION=sessions
SESSION_LIFETIME=120
# true because the real public domain is only ever reached over HTTPS
# (Cloudflare terminates TLS at its edge before the tunnel reaches
# this container) -- matches Flask's own ProductionConfig
# (SESSION_COOKIE_SECURE = True). This is a static flag that governs
# what the *browser* does with the cookie, not proxy-scheme detection,
# so it's correct regardless of what protocol the tunnel uses
# internally to reach this container.
#
# NOTE: while testing privately over plain HTTP (the NAS-local
# Tailscale IP, before the Cloudflare cutover), this must be false --
# a Secure-flagged cookie is silently refused by the browser over
# HTTP, breaking session/CSRF entirely (419 "Page Expired" on every
# login attempt). Flip back to false only if testing that path again.
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PARTITIONED_COOKIE=false
REDIS_SESSION_DB=2
CACHE_STORE=file
QUEUE_CONNECTION=redis
FILESYSTEM_DISK=local

# Realtime broadcasts use an isolated Redis queue, not Laravel's database
# queue tables (this deployment must never migrate the shared Flask DB).
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

BROADCAST_CONNECTION=reverb
# Generate unique values on the NAS; REVERB_APP_KEY is public, the secret is not.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
# Server-to-server publishing stays on the private Compose network.
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
# Comma-separated exact browser origins; add the NAS HTTP origin only while testing it.
REVERB_ALLOWED_ORIGINS=https://customerportal.theomeds.com

# These are baked into the Vite bundle at image build time. The public key must
# match REVERB_APP_KEY. Blank connection fields use the browser's current origin.
VITE_REVERB_APP_KEY=
VITE_REVERB_HOST=
VITE_REVERB_PORT=
VITE_REVERB_SCHEME=

# Never run `php artisan migrate` against this database -- see
# DEPLOY.md's warning. This app reads/writes the existing schema
# directly; it does not own or manage it.

# Left disabled -- no live SMTP/Meta Messenger credentials configured
# for this deployment. See App\Support\OrderNotifications and
# App\Support\FacebookMessenger.
PO_NOTIFICATIONS_EMAIL_ENABLED=false
PO_NOTIFICATIONS_FACEBOOK_ENABLED=false
PO_NOTIFICATIONS_SMS_ENABLED=false
PUBLIC_CONVERSATION_LINK_TTL_HOURS=720
PUBLIC_CONVERSATION_REPLY_MAX_LENGTH=2000
PUBLIC_CONVERSATION_REPLY_WINDOW_SECONDS=900
PUBLIC_CONVERSATION_REPLY_LIMIT=5
META_MESSENGER_PAGE_ACCESS_TOKEN=
META_MESSENGER_APP_SECRET=
META_MESSENGER_WEBHOOK_VERIFY_TOKEN=
META_MESSENGER_GRAPH_API_VERSION=v19.0
SEMAPHORE_API_KEY=
SEMAPHORE_SENDER_NAME=

# The Flask stack's Compose network name -- confirm via
# `docker network ls` on the NAS before first boot (see DEPLOY.md);
# override here if it's not actually customerportal_default.
FLASK_NETWORK_NAME=customerportal_default

# The external network used by cloudflared-wtms. Its public-hostname route
# resolves customerportal-laravel-proxy on this Docker network.
CLOUDFLARE_NETWORK=cloudflared_default

# Which NAS-local port also reaches this app directly (useful for
# testing without going through the public domain/tunnel).
HOST_PORT=8090

# Products now come live from the inventoryapp service instead of a
# local table -- see App\Support\InventoryApiClient.
INVENTORY_API_BASE_URL=https://inventoryapp.theomeds.com/theomeds/inventoryapp/v1
INVENTORY_API_TOKEN=
